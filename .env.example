# --- copy to .env and fill in ---
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string

# Services (docker-compose service names are used inside containers)
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/schoolrag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
STORAGE_DIR=/data/storage

# ---- API keys (a role can override with its own LLM_API_KEY / VLM_API_KEY / EMBED_API_KEY / CONDENSE_API_KEY) ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=

# =====================================================================================================
# Every role picks its own provider + model. Change these lines to switch models -- no code changes.
# See what is available:  docker compose exec api python -m app.cli providers
# =====================================================================================================

# Answers (anthropic | openai). "openai" also works with ANY OpenAI-compatible server (vLLM, Ollama, LM Studio,
# OpenRouter, Together, Groq, Azure...) by setting LLM_BASE_URL.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=

# Follow-up question rewriting (cheap/fast model). Leave CONDENSE_PROVIDER empty to reuse the answer LLM.
CONDENSE_PROVIDER=anthropic
CONDENSE_MODEL=claude-haiku-5-5

# Vision model that reads page images (anthropic | openai)
VLM_PROVIDER=anthropic
VLM_MODEL=claude-sonnet-5-5
# VLM_BASE_URL=

# Embeddings: bge_m3 (local, multilingual, dense+sparse hybrid) | openai (API, dense only)
# NOTE: changing the embedding model creates a NEW vector collection. Fill it with
#       POST /admin/books/{id}/reindex  (re-uses the saved page text: no VLM cost).
EMBED_PROVIDER=bge_m3
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# EMBED_BASE_URL=

# Reranker: bge (local cross-encoder) | none
RERANK_PROVIDER=bge
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Vector store / OCR fallback
VECTORSTORE_PROVIDER=qdrant
OCR_PROVIDER=tesseract
OCR_LANGUAGES=ara+eng+fra

# Extraction: auto | vlm | native
EXTRACTION_MODE=auto
VLM_CONCURRENCY=4

# Default per-student limits (can be overridden per student by admin)
DEFAULT_DAILY_REQUESTS=60
DEFAULT_DAILY_TOKENS=150000
RATE_LIMIT_PER_MINUTE=12
